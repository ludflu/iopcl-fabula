cabal-version:      3.0
name:               narrative-planning
version:            0.1.0.0
synopsis:           IPOCL narrative planner: believable stories from character intentions
license:            BSD-3-Clause
license-file:       LICENSE
author:             James Snavely
maintainer:         ludflu@gmail.com
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options:      -Wall
    default-language: GHC2024
    default-extensions:
        OverloadedStrings
        LambdaCase
        RecordWildCards

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        IPOCL
        IPOCL.Syntax
        IPOCL.Pretty
        IPOCL.DomainCheck
        IPOCL.Bindings
        IPOCL.Order
        IPOCL.Ground
        IPOCL.Plan
        IPOCL.Refine
        IPOCL.Report
        IPOCL.Search
        IPOCL.Validate
        IPOCL.Linearize
        IPOCL.Domains.Tiny
        IPOCL.Domains.Tower
        IPOCL.Domains.Bribe
        IPOCL.Domains.Aladdin
    build-depends:
        base ^>=4.20.2.0,
        containers >=0.6 && <0.8,
        text >=2.0 && <2.2

executable narrative-planning
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded -rtsopts
    build-depends:
        base,
        containers,
        text,
        narrative-planning,
        optparse-applicative >=0.17 && <0.20

test-suite spec
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    other-modules:
        OrderSpec
        BindingsSpec
        GroundSpec
        PlannerSpec
        ValidateSpec
        Helpers
        FetchDomain
        IntentSpec
    build-depends:
        base,
        containers,
        text,
        narrative-planning,
        hspec >=2.10 && <2.12,
        QuickCheck >=2.14 && <2.16
