(define (problem aladdin-1)
  (:domain aladdin)
  (:agents aladdin jafar jasmine dragon genie)
  (:init
    ; Aladdin, the king's loyal knight
    (character aladdin) (male aladdin) (knight aladdin)
    (at aladdin castle) (alive aladdin) (single aladdin)
    (loyal-to aladdin jafar)
    ; Jafar, the king
    (character jafar) (male jafar) (king jafar)
    (at jafar castle) (alive jafar) (single jafar)
    ; Jasmine
    (character jasmine) (female jasmine)
    (at jasmine castle) (alive jasmine) (single jasmine) (beautiful jasmine)
    ; the dragon, which guards the lamp
    (character dragon) (monster dragon) (dragon dragon)
    (at dragon mountain) (alive dragon) (scary dragon)
    ; the genie, confined in the lamp
    (character genie) (monster genie) (genie genie)
    (in genie lamp) (confined genie) (alive genie) (scary genie)
    ; places and things
    (place castle) (place mountain)
    (thing lamp) (magic-lamp lamp)
    (has dragon lamp))
  (:goal (and (married-to jafar jasmine) (not (alive genie))))
  ; The paper's domain-dependent heuristic (Appendix A.1), with its "hero"
  ; and "king" typos read as aladdin and jafar and its duplicates removed.
  (:preferences
    (allow-goals aladdin (has jafar lamp) (not (alive genie)) (not (alive dragon))
      (has aladdin lamp) (married-to aladdin jasmine) :hard)
    (allow-goals jafar (married-to jafar jasmine) :hard)
    (allow-goals jasmine (married-to jasmine jafar) :hard)
    (allow-goals genie (loves jasmine jafar) (loves jafar jasmine) (loves aladdin jasmine) :hard)
    (allow-goals dragon :hard)
    (no-repeat-steps :hard)))
